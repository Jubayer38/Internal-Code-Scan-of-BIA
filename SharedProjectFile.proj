<Project>
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>false</InvariantGlobalization>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<Description>Biometric App API Core</Description>
		<Company>Banglalink</Company>
		<Copyright>Copyright © $([System.DateTime]::Now.ToString('yyyy'))</Copyright>

		<!-- 
		Version information for an assembly consists of the following three values: 
			Architectural Change/Major Update
			Minor/New features
			Patch/Bug fixes
		-->
		<Version>6.5.0</Version>
		<Nullable>enable</Nullable>
		<NoWarn>NU1901;NU1902;NU1903;NU1904;CS0108;CS0219;CS0168;CS1998;CS0472;SYSLIB0021;SYSLIB0022;SYSLIB0053;CA2200;CA1416;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8609;CS8618;CS8619;CS8625;CS8632;CS8765;CS8767;CS8509</NoWarn>
		<NuGetAudit>false</NuGetAudit>
	</PropertyGroup>
</Project>