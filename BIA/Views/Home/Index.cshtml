@using BIA.Entity.StaticClass
@inject AppSettingsKeys AppSettings

@{
    ViewData["Title"] = "Home";
}

<div class="main-container">
    <div class="centered-content">
        <div class="content-card">
            <div class="text-section">
                <h1 class="main-title">Welcome to <br /> Biometric Internal API</h1>
                <p class="subtitle">Secure and reliable biometric app management system</p>
            </div>
            <div class="image-section">
                @if (AppSettings.IsWindows)
                {
                    <img src="~/images/banner.png" alt="Inventory System" class="banner-image" />
                }
                else
                {
                    <img src="/@AppSettings.WWWRootPath/images/banner.png" alt="Biometric System"
                         class="banner-image" />
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Main container with equal spacing */
    .main-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        box-sizing: border-box;
    }

    /* Centered content wrapper */
    .centered-content {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Content card with equal spacing */
    .content-card {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 60px;
        padding: 40px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* Text section */
    .text-section {
        flex: 1;
        min-width: 300px;
        text-align: center;
        padding: 20px;
    }

    .main-title {
        font-size: 2.5rem;
        font-weight: bold;
        color: #2c3e50;
        margin-bottom: 1rem;
        line-height: 1.2;
    }

    .subtitle {
        font-size: 1.2rem;
        color: #6c757d;
        margin-bottom: 0;
    }

    /* Image section */
    .image-section {
        flex: 1;
        min-width: 300px;
        text-align: center;
        padding: 20px;
    }

    .banner-image {
        max-width: 100%;
        height: auto;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease;
    }

        .banner-image:hover {
            transform: scale(1.02);
        }

    /* Mobile responsiveness */
    @@media (max-width: 768px) {
        .main-container {
            padding: 20px 15px;
            min-height: 90vh;
        }

        .content-card {
            gap: 30px;
            padding: 30px 20px;
        }

        .main-title {
            font-size: 2rem;
        }

        .subtitle {
            font-size: 1.1rem;
        }

        .text-section,
        .image-section {
            min-width: 100%;
            padding: 10px;
        }
    }

    /* Extra small devices */
    @@media (max-width: 480px) {
        .main-container {
            padding: 15px 10px;
        }

        .content-card {
            padding: 20px 15px;
            gap: 20px;
        }

        .main-title {
            font-size: 1.8rem;
        }
    }
</style>


